{
  "manifest_version": 3,
  "name": "Screen Distance Reminder",
  "version": "0.1.0",
  "description": "Gently reminds you to sit back when you're too close to your screen, using on-device face detection. Video never leaves your device.",
  "permissions": ["offscreen", "notifications", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
